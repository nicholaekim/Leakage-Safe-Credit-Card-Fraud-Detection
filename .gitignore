# --- Data: never commit the dataset ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Results artifacts (regenerated by code) ---
results/figures/*
results/tables/*
!results/figures/.gitkeep
!results/tables/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- Secrets / OS ---
kaggle.json
.kaggle/
.DS_Store
