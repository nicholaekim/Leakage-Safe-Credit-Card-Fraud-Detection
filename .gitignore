# --- data: never commit the dataset ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- results artifacts (regenerated by code) ---
results/figures/*
results/tables/*
results/scores/
!results/figures/.gitkeep
!results/tables/.gitkeep
# these two have no generating script (hand-made diagram + slide-formatted
# forest plot), so they must be tracked or a fresh clone can't get them
!results/figures/pipeline_overview.png
!results/figures/bootstrap_forest_slide.png

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- presentations / office temp files (keep local, dont push) ---
reports/*.pptx
reports/*.pdf
~$*
.~lock.*#

# --- secrets / OS ---
kaggle.json
.kaggle/
.DS_Store
