# --- Data: never commit the dataset ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- Results artifacts (regenerated by code) ---
results/figures/*
results/tables/*
results/scores/
!results/figures/.gitkeep
!results/tables/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- Presentations / office temp files (keep local, do not push) ---
reports/*.pptx
reports/*.pdf
~$*
.~lock.*#

# --- Secrets / OS ---
kaggle.json
.kaggle/
.DS_Store
